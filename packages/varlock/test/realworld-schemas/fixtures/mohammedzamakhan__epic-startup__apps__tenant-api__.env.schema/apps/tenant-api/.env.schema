# Regional Tenant Node Environment Variables
#
# @currentEnv=$NODE_ENV
# @defaultRequired=infer @defaultSensitive=false
# @generateTypes(lang=ts, path=env.d.ts)
# @import(../../packages/database/.env.schema, pick=[DATABASE_URL])
# @import(../../packages/cache/.env.schema, pick=[INTERNAL_COMMAND_TOKEN])
# @import(../../packages/tenant-db/.env.schema, pick=[TENANT_DB_DIR])
# @import(../../packages/sms/.env.schema, pick=[TWILIO_ACCOUNT_SID,TWILIO_AUTH_TOKEN,TWILIO_FROM_NUMBER])
# @import(../../packages/email/.env.schema, pick=[OCI_TENANCY_OCID,OCI_USER_OCID,OCI_FINGERPRINT,OCI_PRIVATE_KEY,OCI_REGION,OCI_EMAIL_COMPARTMENT_ID,OCI_EMAIL_SENDER_EMAIL,OCI_EMAIL_SENDER_NAME,OCI_EMAIL_SENDER_OCID,OCI_EMAIL_LOG_OCID])
# ----------

# @type=enum(production, development, test) @sensitive=false
NODE_ENV=development

# @required @sensitive=false
PORT=3007

# JWT for customer access tokens. Verified only on tenant-api (browser holds the token).
# @required @sensitive
JWT_SECRET=dev-jwt-secret-do-not-use-in-prod-32b

# HMAC key for OTP and refresh token hashes. Distinct from INTERNAL_COMMAND_TOKEN.
# @required @sensitive
AUTH_HMAC_SECRET=dev-auth-hmac-secret-do-not-use-in-prod

# Secret used to sign/verify short-lived operator JWTs (audience:
# "tenant-api-operator"). MUST differ from INTERNAL_COMMAND_TOKEN so the
# browser-issued operator token cannot authenticate cron/provision routes.
# @required @sensitive
TENANT_OPERATOR_TOKEN=dev-operator-token-do-not-use-in-prod-32b

# Shared only with the voice-agent worker (and App's phone-agent-config route).
# Authenticates /api/voice/* calls from the worker. MUST differ from
# INTERNAL_COMMAND_TOKEN, TENANT_OPERATOR_TOKEN, JWT_SECRET and
# AUTH_HMAC_SECRET (≥32 chars); otherwise, or with this dev default in
# production, the voice routes answer 503.
# @required @sensitive
VOICE_AGENT_TOKEN=dev-voice-agent-token-do-not-use-in-prod-32b

# Call recording bucket written by the voice-agent worker (LiveKit Egress).
# tenant-api only deletes expired or erased recordings. Must match the worker's
# bucket whenever recording is enabled; without it retention purge keeps the
# recording keys and reports them as pending.
# @sensitive=false
RECORDING_S3_BUCKET=
# @sensitive=false
RECORDING_S3_REGION=
# Path-style S3 endpoint (e.g. R2 or OCI Object Storage). Empty uses AWS S3.
# @type=url @required=false @sensitive=false
RECORDING_S3_ENDPOINT=
# @sensitive=false
RECORDING_S3_ACCESS_KEY=
# @sensitive
RECORDING_S3_SECRET=

# US App origin. Used when the control-plane database has no Organization rows (KSA OCI VM).
# @sensitive=false
APP_URL=http://localhost:3001

# Public origin of this node, used for the links in consent emails (double opt-in
# confirmation, unsubscribe). Required in production: the node refuses to start
# without it and never falls back to the request's Host. Local development may
# leave it empty (localhost / *.test request origins are accepted).
# @type=url @required=false @sensitive=false
TENANT_API_URL=

# This node serves only orgs whose dataRegion matches this value.
# Use "us" for the default local process. Run a second process with DATA_REGION=ksa PORT=3009 to test KSA.
# Not a secret — the value "us" would otherwise match every JSON "status" field.
# @required @sensitive=false @type=enum(us, ksa)
DATA_REGION=us

# Root domain used to map browser Origin (acme.epic-startup.com) to an org slug.
# @sensitive=false
ROOT_APP=epic-startup.test

# Set to "workers" on Cloudflare Workers org-router; unset on OCI Node runtime.
# @sensitive=false
TENANT_API_RUNTIME=

# Hourly SMS send cap across all IPs/phones. Defaults to 500 in code.
# @type=number @sensitive=false
GLOBAL_SMS_CAP=500

# Cloudflare Turnstile secret for public website form submissions (siteverify).
# When unset in development, Turnstile verification is skipped.
# @sensitive
TURNSTILE_SECRET_KEY=

# Comma-separated hostnames allowed in Turnstile siteverify responses.
# @sensitive=false
TURNSTILE_HOSTNAMES=localhost,epic-startup.test

# Optional OpenAI-compatible endpoint for mailbox reply drafts. Include /v1.
# The operator must provision an endpoint whose processing AND storage stay
# within MAILBOX_AI_DATA_REGION. No default public provider or cross-region fallback.
# @type=url @required=false @sensitive=false
MAILBOX_AI_BASE_URL=
# @sensitive
MAILBOX_AI_API_KEY=
# @sensitive=false
MAILBOX_AI_MODEL=
# @type=enum(us, ksa) @required=false @sensitive=false
MAILBOX_AI_DATA_REGION=

# Kill switch for the shared-tablet time clock on this node. Unset or true means
# on. false (also 0, off, no, disabled) answers 503 on every /kiosk route and
# refuses new pairing codes; revoking a device always still works. A paired tablet
# holds its device secret locally, so no organization flag can stop it: revoke
# devices first, then use this switch.
# @type=boolean @sensitive=false
STAFFING_KIOSK_ENABLED=true

# Kill switch for staff email (reminders, automatic clock-out notices, time card
# edit notices) from this node. Unset or true means on. false (also 0, off, no,
# disabled) drops those messages instead of holding them, so switching it back on
# never sends a backlog. Manager alerts go through the App, which honors the same
# variable for its emails; in-app notifications are unaffected.
# @type=boolean @sensitive=false
STAFFING_EMAIL_ENABLED=true

# Node (OCI) runtime only: seconds between in-process staff ticks (reminders,
# automatic clock-out, alerts). Default 300, minimum 60, 0 turns the interval off
# and leaves the hourly cron fan-out as the only driver. The Workers runtime uses
# per-organization Durable Object alarms instead and ignores this.
# @type=number @sensitive=false
STAFFING_TICK_INTERVAL_SECONDS=300

# Development only: folder that receives a JSON file per email this node would
# otherwise only log (relative to apps/tenant-api). Ignored when NODE_ENV is
# production or when OCI email is configured. The dev scripts set it per region.
# @type=string @sensitive=false
DEV_EMAIL_CAPTURE_DIR=
