# Shared cache package (SQLite + LRU)
# See https://varlock.dev/guides/monorepos/
#
# @defaultRequired=infer @defaultSensitive=false
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ----------

# SQLite cache file path (cache.server.ts)
# @sensitive=false
CACHE_DATABASE_PATH=./cache.db

# Authenticates cache mutation routes, tenant provision/deprovision, and cron POSTs.
# Shared by App, Admin, tenant-api, and jobs-cron (≥16 chars). Dev default only.
# @sensitive
INTERNAL_COMMAND_TOKEN=dev-internal-command-token-do-not-use-in-prod
