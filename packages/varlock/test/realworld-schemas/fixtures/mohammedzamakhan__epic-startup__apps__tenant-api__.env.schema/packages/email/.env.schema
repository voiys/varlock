# Email delivery package (Resend + OCI)
# See https://varlock.dev/guides/monorepos/
#
# @currentEnv=$NODE_ENV
# @defaultRequired=infer @defaultSensitive=false
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ----------

# @type=enum(production, development, test)
NODE_ENV=development

# @type=enum(resend, oci) @sensitive=false
EMAIL_PROVIDER=resend

# @sensitive
RESEND_API_KEY=

# Enables mock transports in dev/test (oci/mock-transport.ts)
# @type=boolean @sensitive=false
MOCKS=false

# Oracle Cloud Email Delivery
# @sensitive
OCI_TENANCY_OCID=

# @sensitive
OCI_USER_OCID=

# @sensitive=false
OCI_FINGERPRINT=

# @sensitive
OCI_PRIVATE_KEY=

# @sensitive=false
OCI_REGION=

# @sensitive
OCI_EMAIL_COMPARTMENT_ID=

# @sensitive=false
OCI_EMAIL_SENDER_EMAIL=

# @sensitive=false
OCI_EMAIL_SENDER_NAME=Epic Startup

# @sensitive
OCI_EMAIL_SENDER_OCID=

# @sensitive
OCI_EMAIL_LOG_OCID=
