# Declared environment for this project. Checked in; no values here.
# Declare every variable the app reads. Mark secrets @sensitive. Put local
# values in .env.local (gitignored). Validate with `pnpm env:check`, and run
# commands with injected values via `pnpm exec varlock run -- <cmd>`.
# The uncomplect Worker reads no runtime configuration.
#
# @currentEnv=$APP_ENV
# @defaultRequired=false
# @defaultSensitive=true
# ---

# @type=enum(development, test, production)
# @sensitive=false
APP_ENV=development

# Deployment must select a named Alchemy profile.
# @required=forEnv(production)
# @sensitive=false
ALCHEMY_PROFILE=

# Content propagation retry budget in milliseconds. The exported driver default is 120000.
# @type=number
# @sensitive=false
DEPLOY_CONTENT_VERSION_DEADLINE_MS=120000

# Live Worker deployment listing can lag a successful full-cutover upload.
# @type=number
# @sensitive=false
DEPLOY_WORKER_VERSION_DEADLINE_MS=120000

# UTC windows when production deploys must not apply, as JSON. HH:MM times repeat daily: [{"start":"14:00","end":"15:30"}]. :MM times repeat hourly: [{"start":":59","end":":01"}]. Empty means no windows.
# @type=string
# @sensitive=false
DEPLOY_QUIET_WINDOWS=

# How long deployProd may wait for a quiet window to end before it refuses. 0 refuses at once; the maximum is 3600000.
# @type=number
# @sensitive=false
DEPLOY_QUIET_WINDOW_MAX_WAIT_MS=0
