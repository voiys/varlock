# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# A file that holds the auth secret, for `nightshift serve` and the desktop
# app (Docker secrets give it so). Without BETTER_AUTH_SECRET and this file,
# they read BETTER_AUTH_SECRET from the secrets folder below, else make one
# once in the data directory.
# @optional @sensitive=false
BETTER_AUTH_SECRET_FILE=

# This daemon's own address. Not a secret: Devices and pages see it.
# @type=url @sensitive=false
BETTER_AUTH_URL=

# The web app's address. Not a secret: pairing codes link to its Devices page.
# @type=url @sensitive=false
CORS_ORIGIN=

# The database. Defaults to nightshift.db in the data directory. Set it only
# for a database somewhere else, for example a libsql server: libsql://….
# @optional
DATABASE_URL=

# The data directory: the database, the transcripts and the command logs of
# this daemon. Defaults to the app data directory of the OS:
# ~/Library/Application Support/Night Shift on macOS,
# $XDG_DATA_HOME/nightshift (else ~/.local/share/nightshift) on Linux,
# %APPDATA%\Night Shift on Windows. Two daemons never share one.
# @optional @sensitive=false
NIGHTSHIFT_DATA_DIR=

# Set by `bun run dev`: the data directory defaults to .nightshift-dev/ in this
# checkout instead, so a dev daemon keeps out of the night's data.
# @optional @sensitive=false
NIGHTSHIFT_DEV=

# Every NIGHTSHIFT_* value below is a fallback: a value saved on the Settings
# or Agents page wins. NIGHTSHIFT_SCHEDULER=off is the one exception.

# The `claude` executable for Claude Code Agent and Decision nodes. Defaults to
# `claude` on the PATH.
# @optional @sensitive=false
NIGHTSHIFT_CLAUDE_BIN=

# The `opencode` executable for OpenCode Agent nodes. Defaults to `opencode` on
# the PATH. It must be a 1.x build: @tanstack/ai-opencode 0.5 cannot drive the
# 2.x server (see docs/PLAN.md §7).
# @optional @sensitive=false
NIGHTSHIFT_OPENCODE_BIN=

# The `codex` executable for Codex Agent nodes. Defaults to `codex` on the PATH.
# @optional @sensitive=false
NIGHTSHIFT_CODEX_BIN=

# The `grok` executable for Grok Build Agent nodes. Defaults to `grok` on the PATH.
# @optional @sensitive=false
NIGHTSHIFT_GROK_BIN=

# The `copilot` executable for GitHub Copilot Agent nodes. Defaults to
# `copilot` on the PATH.
# @optional @sensitive=false
NIGHTSHIFT_COPILOT_BIN=

# The `gemini` executable for Gemini CLI Agent nodes. Defaults to `gemini` on
# the PATH.
# @optional @sensitive=false
NIGHTSHIFT_GEMINI_BIN=

# The Cursor CLI (`agent`) for Cursor Agent nodes. Defaults to `agent` on the
# PATH.
# @optional @sensitive=false
NIGHTSHIFT_CURSOR_BIN=

# The `pi` executable for pi Agent nodes. Defaults to `pi` on the PATH.
# Night Shift starts it through pi-acp, which it ships.
# @optional @sensitive=false
NIGHTSHIFT_PI_BIN=

# How many runs may run a step at once. Defaults to 2.
# @optional @sensitive=false
NIGHTSHIFT_MAX_CONCURRENT_RUNS=

# The most steps one run may take, unless its flow sets maxSteps. Defaults to 500.
# @optional @sensitive=false
NIGHTSHIFT_MAX_STEPS_PER_RUN=

# "off": this daemon starts no scheduled runs, whatever the Settings page says.
# Set it for a dev daemon, so only the night daemon (`bun run night`) starts them.
# @optional @sensitive=false
NIGHTSHIFT_SCHEDULER=

# "off": a run the daemon stopped mid-step waits for a person after a restart,
# instead of continuing on its own. Defaults to on (only with the scheduler on).
# @optional @sensitive=false
NIGHTSHIFT_RESUME_INTERRUPTED_RUNS=

# "on": this computer stays awake while a run on it is running. A fallback for
# "Keep this computer awake" in Settings. Defaults to off.
# @optional @sensitive=false
NIGHTSHIFT_KEEP_AWAKE=

# "off": this daemon shows no notifications on this computer's desktop. Defaults
# to on where the computer has a desktop. The tests set it off.
# @optional @sensitive=false
NIGHTSHIFT_DESKTOP_NOTIFICATIONS=

# "on": this computer is a Host: other Devices may pair with it. A fallback for
# "Be a Host" on the Devices page. Defaults to off.
# @optional @sensitive=false
NIGHTSHIFT_HOST=

# The Host's https:// addresses, in the order Devices try them, separated by
# commas: for example https://studio.local,https://studio.example.com. A
# fallback for the addresses on the Devices page. A Host answers other
# computers only once it has an https:// address.
# @optional @sensitive=false
NIGHTSHIFT_HOST_ADDRESSES=

# A certificate and its key (PEM files) for the daemon to serve https://
# itself, for example a self-signed one on a LAN. Devices pin a self-signed
# certificate when they pair: its fingerprint shows on the Devices page.
# @optional @sensitive=false
NIGHTSHIFT_TLS_CERT=
# @optional @sensitive=false
NIGHTSHIFT_TLS_KEY=

# The https:// port when this daemon serves its own certificate, as
# `nightshift serve` and the desktop app do: this computer keeps plain http on
# PORT (on 127.0.0.1), other computers use this port. Defaults to PORT + 443.
# @optional @sensitive=false
NIGHTSHIFT_TLS_PORT=

# "on": people who sign in from another computer must use two-factor sign-in
# (a code from an authenticator app). Until they turn it on, they can only set
# it up and sign out. This computer and paired Devices are not affected.
# Defaults to off.
# @optional @sensitive=false
NIGHTSHIFT_REQUIRE_TWO_FACTOR=

# Where a Host listens. Defaults to 0.0.0.0 (every network). Set 127.0.0.1 when
# the Host's way out runs on this computer (Tailscale Serve, Cloudflare Tunnel,
# a reverse proxy), so the LAN cannot reach it directly. A computer that is not
# a Host always listens on 127.0.0.1.
# @optional @sensitive=false
NIGHTSHIFT_LISTEN=

# A built web UI (apps/web/dist/client) for `nightshift serve` to serve itself.
# The `nightshift` binary carries its own.
# @optional @sensitive=false
NIGHTSHIFT_WEB_DIR=

# A folder of secret files, one per secret, named as the secret: a `${NAME}`
# reads them like the environment. For a computer without a keychain, for
# example /run/secrets in Docker. Defaults to systemd's credentials folder
# (CREDENTIALS_DIRECTORY) when the service has one.
# @optional @sensitive=false
NIGHTSHIFT_SECRETS_DIR=

# "file": keep the Device keys of the Hosts this computer paired with, and the
# secrets saved on the Connections page, in the data directory (readable by
# this user only), not in the system keychain. Without a keychain (a headless
# server) that is where they go anyway.
# @optional @sensitive=false
NIGHTSHIFT_KEY_STORE=

# The Expo access token of the Night Shift phone app's project, for push
# notifications to phones. Optional: without it, pushes still go out while the
# project does not require one ("enhanced push security" off in Expo).
# Recommended for a Host with phones, with enhanced push security on: then
# nobody else who learns a phone's push token can push to it.
# @optional
EXPO_ACCESS_TOKEN=
