# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.generated.ts, exposeEnv=local)
# Vercel bakes the resolved env into the build (see vite.config.ts); encrypt it there.
# Needs _VARLOCK_ENV_KEY (from `varlock generate-key`) set on Vercel for build and runtime.
# @encryptInjectedEnv
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# Public site origin; it appears in rendered pages (og:url, og:image)
# @public @type=url
BETTER_AUTH_URL=

# MongoDB, used only for Better Auth's user/session/account tables
# @type=string(minLength=1)
DATABASE_URL=

# --- Access control ---

# Comma-separated email domains allowed to sign in
# @public
ALLOWED_EMAIL_DOMAINS=example.edu

# Comma-separated full email addresses allowed to sign in regardless of domain
# @optional @sensitive=false
ALLOWED_EMAILS=

# Comma-separated emails with admin rights (delete anything, ban users)
# @optional @sensitive=false
ADMIN_EMAILS=

# --- Upstash Redis (app data, sessions, rate limits) ---

# @type=url
UPSTASH_REDIS_REST_URL=

# @type=string(minLength=1)
UPSTASH_REDIS_REST_TOKEN=

# --- Cloudflare R2 (media storage) ---

# @public @type=string(minLength=1)
R2_ACCOUNT_ID=

# Not a secret: it appears in every presigned URL (the secret key never does)
# @sensitive=false @type=string(minLength=1)
R2_ACCESS_KEY_ID=

# @type=string(minLength=1)
R2_SECRET_ACCESS_KEY=

# @public @type=string(minLength=1)
R2_BUCKET=

# Optional S3-compatible endpoint override for local development (e.g. MinIO: http://localhost:9000)
# @public @optional @type=url
R2_ENDPOINT=

# --- Cloudflare Turnstile ---
# Test keys (always pass): site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA

# @public @type=string(minLength=1)
TURNSTILE_SITE_KEY=

# @type=string(minLength=1)
TURNSTILE_SECRET_KEY=

# --- Email (magic links) ---
# Without RESEND_API_KEY, magic links are printed to the server console (development only).

# @optional
RESEND_API_KEY=

# @public
EMAIL_FROM=picslop <noreply@example.com>
