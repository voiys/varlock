# @defaultSensitive=false @defaultRequired=true
# @generateTypes(lang=ts, path=src/env.d.ts, auto=false)
# @currentEnv=$NODE_ENV

# Application runtime environment (development/production etc.)
# @type=string
NODE_ENV=development

# Where the API mounts under (e.g. "/" or "/api")
# @type=string
BASE_URL=/

# HTTP port the server listens on
# @type=number
PORT=3000

# Postgres connection string. In dev mode, defaults to a local Postgres on :5432.
# Override in .env for any other environment.
# @type=string @sensitive
DATABASE_URL=if(forEnv(development), "postgres://postgres:postgres@localhost:5432/battlelog")

# When true, mount /rmapi/* routes for RM (Rasenmaeher) integration. On by
# default: the RM deployment injects no app env beyond the DB config, so a
# false default would leave the product silently unreachable to RM.
# @type=boolean
RM_API_ENABLED=true

# When true, /rmapi/* endpoints reject callers without an expected mTLS DN header.
# Off in dev — no proxy locally to inject the header.
# @type=boolean
RM_MTLS_ENFORCE=if(forEnv(development), false, true)

# Header name that carries the client's mTLS DN.
# @type=string
RM_MTLS_HEADER=x-clientcert-dn

# Expected CN for RM callers. If unset, falls back to kraftwerk-init.json then "rasenmaeher".
# @required=false @type=string
RM_EXPECTED_CERT_CN=

# When true, /api/* writes require mTLS-derived user identity (cert CN from
# RM_MTLS_HEADER becomes createdBy/updatedBy). Off in dev — no proxy locally.
# @type=boolean
RM_MTLS_USER_ENFORCE=if(forEnv(development), false, true)

# When true, expose /openapi.json + /api-docs swagger UI. Enabled by default in dev.
# @type=boolean
USE_SWAGGER=if(forEnv(development), true, false)

# OTLP endpoint for OpenTelemetry traces/metrics. When unset, the SDK is not started.
# @required=false @type=string
OTEL_EXPORTER_OTLP_ENDPOINT=

# Pino log level.
# @type=enum(trace,debug,info,warn,error,fatal)
LOG_LEVEL=info
