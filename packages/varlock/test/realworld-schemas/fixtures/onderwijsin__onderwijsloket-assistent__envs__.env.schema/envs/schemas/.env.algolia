# @defaultRequired=infer
# @defaultSensitive=false
# ---


# API key for Algolia instance
# @required
# @sensitive
# @type=string
# @docs(https://www.algolia.com/doc/libraries/sdk/request-options)
ALGOLIA_TOKEN=protonPass(concat(pass://${PROTON_VAULT}/, $APP_ENV, /ALGOLIA_TOKEN))


# Application ID for the algolia instance
# @required
# @public
# @type=string
# @docs(https://www.algolia.com/doc/libraries/sdk/request-options)
ALGOLIA_APPLICATION_ID=protonPass(concat(pass://${PROTON_VAULT}/, $APP_ENV, /ALGOLIA_APPLICATION_ID))