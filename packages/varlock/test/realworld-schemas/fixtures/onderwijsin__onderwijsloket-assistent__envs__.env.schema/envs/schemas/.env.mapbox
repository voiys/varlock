# @defaultRequired=infer
# @defaultSensitive=false
# ---

# Server-only Mapbox token. Required only when geocoding is called.
# @optional
# @sensitive
# @type=string
MAPBOX_API_TOKEN=protonPass(concat(pass://${PROTON_VAULT}/, $APP_ENV, /MAPBOX_API_TOKEN))

# Select temporary geocoding. False enables permanent, billable geocoding.
# @type=boolean
# @dynamic
MAPBOX_ENABLE_TEMPORARY_GEOCODING=protonPass(concat(pass://${PROTON_VAULT}/, $APP_ENV, /MAPBOX_ENABLE_TEMPORARY_GEOCODING))

# Cache results for 90 days independently of mode. Disable for temporary geocoding per Mapbox terms.
# @type=boolean
# @dynamic
MAPBOX_ENABLE_GEOCODING_CACHE=protonPass(concat(pass://${PROTON_VAULT}/, $APP_ENV, /MAPBOX_ENABLE_GEOCODING_CACHE))
