# @defaultRequired=infer
# @defaultSensitive=false
# ---

# Server-only organisation admin token. Scheduling fails closed when unavailable.
# @optional
# @sensitive
# @type=string
# @docs(https://developers.savvycal.com/authentication)
SAVVYCAL_API_KEY=protonPass(concat(pass://${PROTON_VAULT}/, $APP_ENV, /SAVVYCAL_API_KEY), allowMissing=true)
