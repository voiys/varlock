# @defaultRequired=infer
# @defaultSensitive=false
# ---

# Directus instance URL for server-side communication
# @sensitive
# @required
# @type=url(noTrailingSlash=true)
# @docs(https://github.com/onderwijsin/nuxt-modules/blob/main/modules/directus-client/README.md#configuration)
DIRECTUS_URL=protonPass(concat(pass://${PROTON_VAULT}/, $APP_ENV, /DIRECTUS_URL))

# Directus asset proxy url
# @public
# @required
# @type=url(noTrailingSlash=true)
DIRECTUS_ASSET_URL=protonPass(concat(pass://${PROTON_VAULT}/, $APP_ENV, /DIRECTUS_ASSET_URL))


# Static token for server-side communication with Directus
# @required
# @sensitive
# @type=string
# @docs(https://github.com/onderwijsin/nuxt-modules/blob/main/modules/directus-client/README.md#configuration)
DIRECTUS_PROXY_TOKEN=protonPass(concat(pass://${PROTON_VAULT}/, $APP_ENV, /DIRECTUS_PROXY_TOKEN))


# Introspection token for Directus type generation
# @required
# @sensitive
# @type=string
# @docs(https://github.com/onderwijsin/nuxt-modules/blob/main/modules/directus-client/README.md#configuration)
DIRECTUS_INTROSPECTION_TOKEN=protonPass(concat(pass://${PROTON_VAULT}/, $APP_ENV, /DIRECTUS_INTROSPECTION_TOKEN))