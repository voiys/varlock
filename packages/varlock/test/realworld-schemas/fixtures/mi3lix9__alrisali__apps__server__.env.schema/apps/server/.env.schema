# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# @type=string(minLength=1)
DATABASE_AUTH_TOKEN=

# Sentry DSN for server errors. Unset: errors are only logged.
# @optional @type=url
SENTRY_DSN=

# Email and password sign-in and sign-up (app account screen and admin web),
# for local development and test accounts. Unset: on outside production, off
# in production. Setting it to true in production stops the server from
# starting: production signs in with Apple and Google only.
# @optional @type=boolean @sensitive=false
AUTH_DEV_EMAIL_PASSWORD=

# Google OAuth client IDs (comma-separated) whose ID tokens the native Google
# sheet may present: the web client ID the app passes as `webClientId` FIRST,
# then the iOS and Android client IDs. From Google Cloud Console >
# Credentials. The Admin web's Google sign-in uses the first (web) client.
# @type=string(minLength=1) @sensitive=false
GOOGLE_CLIENT_IDS=

# The web client's secret (the first GOOGLE_CLIENT_IDS entry), for the Admin
# web's Google sign-in. Add `<BETTER_AUTH_URL>/api/auth/callback/google` to
# the client's authorized redirect URIs. Unset: the web has no Google button.
# @optional
GOOGLE_CLIENT_SECRET=

# iOS bundle IDs (comma-separated) of the app builds: the audience of the ID
# tokens the native Apple sheet issues.
# @type=string(minLength=1) @sensitive=false
APPLE_BUNDLE_IDS=com.alrisali.app,com.alrisali.app.dev

# Sign in with Apple key, for Apple's REST API: revoking a Believer's Sign in
# with Apple when they delete their account (Apple requires it), and the
# Admin web sign-in with Apple (APPLE_WEB_SERVICES_ID). Unset: deletion skips
# the revocation with a logged warning. Apple Developer > Membership: the
# Team ID.
# @optional @sensitive=false
APPLE_TEAM_ID=

# Apple Developer > Certificates, IDs & Profiles > Keys: the Key ID of a key
# with Sign in with Apple enabled, for the app's primary App ID.
# @optional @sensitive=false
APPLE_KEY_ID=

# That key's .p8 file contents (-----BEGIN PRIVATE KEY----- ...). Newlines
# may be written as \n.
# @optional
APPLE_PRIVATE_KEY=

# The Services ID (Apple Developer > Identifiers > Services IDs) of the Admin
# web's Sign in with Apple, grouped with the app's primary App ID so an Admin
# keeps one account on the phone and the web. Its return URL is
# `<BETTER_AUTH_URL>/api/auth/callback/apple`. Needs the Apple key above;
# unset, the web has no Apple button.
# @optional @sensitive=false
APPLE_WEB_SERVICES_ID=

# Believers' cloud databases (ADR-0001) on Turso Cloud, via the Platform API.
# Set all three, or none to use LOCAL_SYNC_SERVER_URL (not allowed in
# production). Organization slug, from `turso org list`.
# @optional @sensitive=false
TURSO_ORG=

# Platform API token: `turso auth api-tokens mint alrisali-server`.
# @optional
TURSO_API_TOKEN=

# The group every Believer's database is created in (`turso group list`).
# @optional @sensitive=false
TURSO_GROUP=

# Development only, used when TURSO_* are unset: a local
# `tursodb --sync-server` (`bun run db:sync-server`) standing in for Turso
# Cloud. Devices sync at this URL too, so use the machine's LAN address for a
# physical device or the Android emulator (http://10.0.2.2:8090).
# @optional @type=url @sensitive=false
LOCAL_SYNC_SERVER_URL=http://127.0.0.1:8090

# The shared content database (ADR-0001) Admins publish to and every device
# pulls a read-only replica of. Created on the same host as Believers'
# databases (Turso Cloud in TURSO_GROUP, or the local sync server).
# @type=string(minLength=1) @sensitive=false
CONTENT_DATABASE_NAME=content

# Expo access token for sending Announcements through Expo Push. Needed only
# when the Expo project enforces push security (Expo dashboard > Project
# settings > Push notifications); without it pushes are sent unauthenticated.
# Create it at expo.dev > Account settings > Access tokens.
# @optional
EXPO_ACCESS_TOKEN=

# Over-the-air updates (Hot Updater). Required in production; in local
# development the update routes stay off until every HOT_UPDATER_* variable is
# set. The bucket is the Railway bucket holding the update bundles: on Railway,
# reference its variables (BUCKET, ENDPOINT, REGION, ACCESS_KEY_ID,
# SECRET_ACCESS_KEY). The CLI that deploys updates uses the same bucket.
# @required=forEnv(production) @sensitive=false
HOT_UPDATER_BUCKET=

# @required=forEnv(production) @type=url @sensitive=false
HOT_UPDATER_BUCKET_ENDPOINT=

# @required=forEnv(production) @sensitive=false
HOT_UPDATER_BUCKET_REGION=

# Not secret: every presigned download URL carries it (X-Amz-Credential), and
# varlock would block those responses as a leak if it were sensitive.
# @required=forEnv(production) @sensitive=false
HOT_UPDATER_BUCKET_ACCESS_KEY_ID=

# @required=forEnv(production)
HOT_UPDATER_BUCKET_SECRET_ACCESS_KEY=

# Bearer token the `hot-updater` CLI sends to the admin routes. Generate with
# `openssl rand -hex 32`. Never put it in the app.
# @required=forEnv(production) @type=string(minLength=32)
HOT_UPDATER_ADMIN_TOKEN=

# Client API key the app sends on update checks (the app's
# EXPO_PUBLIC_HOT_UPDATER_API_KEY). Hot Updater requires 32 random bytes in
# base64url: `openssl rand -base64 32 | tr '+/' '-_' | tr -d =`. The deploy
# step registers it.
# @required=forEnv(production) @type=string(minLength=43, maxLength=43)
HOT_UPDATER_CLIENT_API_KEY=
# The Railway bucket Admins' files are uploaded to (Speaker photos, Slides,
# Library Assets), separate from the update bundles' bucket. Required in
# production; elsewhere uploads answer "unavailable" until all five are set.
# On Railway, reference the bucket's BUCKET, ENDPOINT, REGION, ACCESS_KEY_ID
# and SECRET_ACCESS_KEY. `bun run files:prepare` (part of deploy:migrate) lets
# the admin web upload to it from the browser (bucket CORS).
# @required=forEnv(production) @sensitive=false
FILES_BUCKET=

# @required=forEnv(production) @type=url @sensitive=false
FILES_BUCKET_ENDPOINT=

# @required=forEnv(production) @sensitive=false
FILES_BUCKET_REGION=

# Not secret: every presigned URL carries it (X-Amz-Credential), and varlock
# would block those responses as a leak if it were sensitive.
# @required=forEnv(production) @sensitive=false
FILES_BUCKET_ACCESS_KEY_ID=

# @required=forEnv(production)
FILES_BUCKET_SECRET_ACCESS_KEY=

# Buckets Railway created before virtual-hosted URLs want path-style ones:
# the bucket's Credentials tab says which.
# @type=boolean @sensitive=false
FILES_BUCKET_PATH_STYLE=false
