# Epic Stack - Main Application
# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
#
# @currentEnv=$NODE_ENV
# @defaultRequired=infer @defaultSensitive=false
# @generateTypes(lang=ts, path=env.d.ts)
# @import(../../packages/database/.env.schema, pick=[DATABASE_URL,DATABASE_PATH])
# @import(../../packages/auth/.env.schema, pick=[SESSION_SECRET,IMPERSONATION_SESSION_SECRET,GITHUB_CLIENT_ID,GITHUB_CLIENT_SECRET,GITHUB_REDIRECT_URI,GITHUB_TOKEN,GOOGLE_CLIENT_ID,GOOGLE_CLIENT_SECRET,GOOGLE_REDIRECT_URI])
# @import(../../packages/security/.env.schema, pick=[HONEYPOT_SECRET,SSO_ENCRYPTION_KEY,INTEGRATION_ENCRYPTION_KEY,TRUST_PROXY,TRUSTED_PROXY_COUNT])
# @import(../../packages/audit/.env.schema, pick=[AUDIT_LOG_SECRET_KEY,AUDIT_LOG_OLD_SECRET_KEY,AUDIT_LOG_SECRET_KEYS])
# @import(../../packages/cache/.env.schema, pick=[CACHE_DATABASE_PATH,INTERNAL_COMMAND_TOKEN])
# @import(../../packages/email/.env.schema, pick=[EMAIL_PROVIDER,RESEND_API_KEY,MOCKS,OCI_TENANCY_OCID,OCI_USER_OCID,OCI_FINGERPRINT,OCI_PRIVATE_KEY,OCI_REGION,OCI_EMAIL_COMPARTMENT_ID,OCI_EMAIL_SENDER_EMAIL,OCI_EMAIL_SENDER_NAME,OCI_EMAIL_SENDER_OCID,OCI_EMAIL_LOG_OCID])
# @import(../../packages/integrations/.env.schema, pick=[INTEGRATIONS_OAUTH_STATE_SECRET,JIRA_CLIENT_ID,JIRA_CLIENT_SECRET,SLACK_CLIENT_ID,SLACK_CLIENT_SECRET,LINEAR_CLIENT_ID,LINEAR_CLIENT_SECRET,GITLAB_CLIENT_ID,GITLAB_CLIENT_SECRET,CLICKUP_CLIENT_ID,CLICKUP_CLIENT_SECRET,NOTION_CLIENT_ID,NOTION_CLIENT_SECRET,ASANA_CLIENT_ID,ASANA_CLIENT_SECRET,TRELLO_API_KEY,TRELLO_API_SECRET,GITHUB_INTEGRATION_CLIENT_ID,GITHUB_INTEGRATION_CLIENT_SECRET])
# @import(../../packages/observability/.env.schema, pick=[SERVICE_NAME,SERVICE_VERSION,BETTERSTACK_API_KEY,BETTERSTACK_URL])
# @import(../../packages/payments/.env.schema, pick=[TRIAL_DAYS,CREDIT_CARD_REQUIRED_FOR_TRIAL])
# @import(../../packages/tenant-db/.env.schema, pick=[TENANT_DB_DIR])
# ----------

# @type=enum(production, development, test) @sensitive=false
NODE_ENV=development

# Signing secret from Resend Dashboard → Webhooks (email.opened, email.clicked).
# Only used when EMAIL_PROVIDER=resend. Webhook URL: {BASE_URL}/api/resend/webhook
# @sensitive
RESEND_WEBHOOK_SECRET=whsec_***

# Public PostHog project token used by browser analytics and server-side events.
# Project tokens start with `phc_` and are safe to expose to the browser.
# @sensitive=false
POSTHOG_PROJECT_TOKEN=

# PostHog ingestion host for the project's data region.
# @type=url @sensitive=false
POSTHOG_HOST=https://us.i.posthog.com

# Public origin of this app (`https://app.{apex}`). Cookie Domain is inferred
# as `.{apex}` so app. and admin. share the session. Leave as localhost in dev.
# @required @type=url @sensitive=false @dynamic
BASE_URL="https://app.epic-startup.test:2999"

# Match BASE_URL when using the HTTPS dev proxy (`npm run dev` on :2999).
# @type=url @sensitive=false @dynamic
GITHUB_REDIRECT_URI="https://app.epic-startup.test:2999/auth/github/callback"

# @type=url @sensitive=false @dynamic
GOOGLE_REDIRECT_URI="https://app.epic-startup.test:2999/auth/google/callback"

# Extra apex domains the website editor may iframe (tenant Sites).
# Comma-separated. Also derived at runtime from the App Host header and BASE_URL.
# @sensitive=false
PUBLIC_SITE_HOST_SUFFIXES=

# CF_DATACENTER, REGION, and DEPLOYMENT_ID are runtime-injected by Cloudflare Workers
# (see packages/observability/src/runtime-env.ts) — not declared in this schema.

# @required @sensitive @type=string(startsWith="sk_")
STRIPE_SECRET_KEY=sk_test_***

# Publishable key for the same Stripe account (embedded tenant shop checkout).
# @required @sensitive=false @type=string(startsWith="pk_")
STRIPE_PUBLISHABLE_KEY=pk_test_***

# @required @sensitive @type=string(startsWith="whsec_")
STRIPE_WEBHOOK_SECRET=whsec_***

# Polar organization access token for tenant shop checkout (Merchant of Record).
# Optional. Polar shops stay disabled until this is set.
# @sensitive
POLAR_ACCESS_TOKEN=

# Polar organization ID. Required when POLAR_ACCESS_TOKEN is a personal token
# rather than an organization access token.
# @sensitive=false
POLAR_ORGANIZATION_ID=

# Polar API environment for shop checkout. Defaults to sandbox.
# @type=enum(sandbox, production) @sensitive=false
POLAR_SERVER=sandbox

# Polar webhook secret from the Polar dashboard (order.paid, checkout.updated).
# @sensitive
POLAR_WEBHOOK_SECRET=

# Checkout.com secret API key (sk_sbox_ / sk_).
# @sensitive
CHECKOUT_SECRET_KEY=

# Checkout.com public key (pk_sbox_ / pk_).
# @sensitive
CHECKOUT_PUBLIC_KEY=

# Account-specific API subdomain prefix from Dashboard → Developers.
# @sensitive=false
CHECKOUT_SUBDOMAIN=

# Processing channel ID for tenant shop payments.
# @sensitive=false
CHECKOUT_PROCESSING_CHANNEL_ID=

# @type=enum(sandbox, production) @sensitive=false
CHECKOUT_ENVIRONMENT=sandbox

# Checkout.com webhook signature key (payment_approved, payment_captured).
# @sensitive
CHECKOUT_WEBHOOK_SECRET=

# Second Stripe webhook signing secret, for Connect events (`account.updated`).
# Optional. When set, the Stripe webhook route accepts either secret and the
# payment mock signs Connect events with it. See docs/payments-mock.md.
# @sensitive
STRIPE_CONNECT_WEBHOOK_SECRET=

# Local Stripe and Checkout.com emulators (never in a Cloudflare production
# build). `true` turns them on without MOCKS, `false` forces them off even with
# MOCKS=true. A real test key for a provider keeps that provider real.
# See docs/payments-mock.md.
# @sensitive=false
PAYMENTS_MOCK=

# Origin of the mock hosted pages. Defaults to BASE_URL.
# @sensitive=false
PAYMENTS_MOCK_ORIGIN=

# How the mock delivers signed webhooks: inline (before the redirect),
# deferred (shortly after) or manual (only on POST /mock-payments/dev/events/flush).
# @sensitive=false
PAYMENTS_MOCK_WEBHOOKS=

# `1` POSTs mock webhooks over HTTP to PAYMENTS_MOCK_ORIGIN instead of calling
# the route in process.
# @sensitive=false
PAYMENTS_MOCK_WEBHOOKS_HTTP=

# `true` puts the hosted page id on Checkout.com webhooks as
# processing.payment_session_id (unverified against the real API; off by default).
# @sensitive=false
PAYMENTS_MOCK_CKO_SESSION_ID=

# @type=url @sensitive=false
STRIPE_PORTAL_URL=https://billing.stripe.com/p/login/test_***

# @type=enum(CLOSED_BETA, PUBLIC_BETA, LAUNCHED) @sensitive=false
# See docs/launch-checklist.md for phase behavior and rollout steps.
LAUNCH_STATUS=LAUNCHED

# Signs short-lived operator JWTs (audience: "tenant-api-operator") that the
# app UI uses to call the regional tenant-api directly from the browser.
# MUST differ from INTERNAL_COMMAND_TOKEN.
# @required @sensitive
TENANT_OPERATOR_TOKEN=dev-operator-token-do-not-use-in-prod-32b

# Shared only with the voice-agent worker and every tenant-api (≥32 chars).
# Authenticates /resources/phone-agent-config. MUST differ from
# INTERNAL_COMMAND_TOKEN and TENANT_OPERATOR_TOKEN. The default below is
# refused when NODE_ENV=production.
# @required @sensitive @type=string(minLength=32)
VOICE_AGENT_TOKEN=dev-voice-agent-token-do-not-use-in-prod-32b

# Cloudflare jobs-cron Worker URL (storage migration workflow + cron triggers)
# @type=url @sensitive=false
JOBS_CRON_WORKER_URL=http://localhost:8787

# @type=boolean @sensitive=false
ALLOW_INDEXING=true

# Tigris Object Storage (S3-compatible) Configuration
# Access key ID is an identifier (also appears in SigV4 presigned URLs); not secret.
# @required @sensitive=false
AWS_ACCESS_KEY_ID=mock-access-key

# @required @sensitive
AWS_SECRET_ACCESS_KEY=mock-secret-key

# @required @sensitive=false
AWS_REGION=auto

# @required @type=url @sensitive=false
AWS_ENDPOINT_URL_S3=https://example.r2.cloudflarestorage.com

# @required @sensitive=false
BUCKET_NAME=mock-bucket

# ---------- External Services ----------

# Google AI
# @sensitive
GOOGLE_GENERATIVE_AI_API_KEY=

# Chrome Extension
# @sensitive=false
EXTENSION_ID=

# ---------- Enterprise SSO Configuration ----------

# @type=boolean @sensitive=false
SSO_ENABLED=false

# ---------- Discord Integration ----------
# Waitlist Discord OAuth (+2 points). Full setup: docs/launch-checklist.md and
# apps/app/docs/DISCORD_INTEGRATION.md
# @docs(https://discord.com/developers/applications)
# @type=url @sensitive=false
DISCORD_INVITE_URL=https://discord.gg/your-server

# Optional WhatsApp community group invite shown on the waitlist.
# WhatsApp membership is not auto-verified; admins can award points manually.
# @type=url @sensitive=false
WHATSAPP_GROUP_INVITE_URL=

# @sensitive=false
DISCORD_CLIENT_ID=

# @sensitive
DISCORD_CLIENT_SECRET=

# @type=url @sensitive=false
DISCORD_REDIRECT_URI=

# @sensitive=false
DISCORD_GUILD_ID=

# JWT for API authentication
# @required @sensitive
JWT_SECRET=your-jwt-secret

# ---------- Build-time Variables ----------

# PostHog source map upload. The personal key needs Error Tracking write access.
# @sensitive
POSTHOG_PERSONAL_API_KEY=

# @sensitive=false
POSTHOG_PROJECT_ID=

# Release identifier used to correlate client logs and uploaded source maps.
# @sensitive=false
COMMIT_SHA=

# ---------- Cloudflare for SaaS (Sites custom domains) ----------
# Optional in local/dev. When unset, custom domains are stored locally only.
# @docs(https://developers.cloudflare.com/cloudflare-for-platforms/cloudflare-for-saas/)
# @sensitive
CLOUDFLARE_API_TOKEN=

# @sensitive=false
CLOUDFLARE_ZONE_ID=

# CNAME target customers point their domain at (e.g. sites.epic-startup.com)
# @sensitive=false
CLOUDFLARE_CUSTOM_HOSTNAME_CNAME_TARGET=sites.epic-startup.com

# Base URL for Cloudflare Media Transformations (/cdn-cgi/media). Must be a
# Cloudflare-proxied hostname with Transformations enabled. Leave empty in dev
# to fall back to direct video source URLs.
# @type=url @sensitive=false
MEDIA_TRANSFORM_BASE_URL=

# Optional external documentation URL. When empty, the App sidebar omits the
# Get help link.
# @type=url @sensitive=false
DOCS_URL=

# Regional tenant-api (US data plane). Used for server-to-server provision,
# deprovision, and App loader fetchTenant. Local default matches
# `npm run dev:tenant-api`. Do not pass this URL to the browser when the App is
# served over HTTPS (mixed content).
# @type=url @sensitive=false
TENANT_API_URL=http://localhost:3007

# KSA tenant-api. Local default matches `npm run dev:tenant-api:ksa` (port 3009).
# @type=url @sensitive=false
TENANT_API_URL_KSA=http://localhost:3009

# Kill switch for staffing manager-alert email (someone has not clocked in, a
# forgotten clock-out, overtime close). Unset or true means on. false (also 0,
# off, no, disabled) stops those emails; in-app notifications are unaffected.
# tenant-api honors the same variable for staff email on its own nodes.
# @type=boolean @sensitive=false
STAFFING_EMAIL_ENABLED=true

# Verifies tenant-site customer access tokens on US shop checkout endpoints.
# MUST match the US tenant-api `JWT_SECRET` (not App operator `JWT_SECRET`).
# @required @sensitive
TENANT_CUSTOMER_JWT_SECRET=dev-jwt-secret-do-not-use-in-prod-32b

# Optional. Google Cloud Translation API key for the page-builder Translate buttons.
# @sensitive
GOOGLE_API_KEY=

# @sensitive=false
ROOT_APP=epic-startup.test

# LiveKit project for the AI phone agent (US only). App mints browser test-call
# tokens with these; the voice-agent worker uses the same project. Leave empty
# to hide test calls. Local: `livekit-server --dev` → ws://localhost:7880,
# key `devkey`, secret `secret`. Cloud: wss://<project>.livekit.cloud.
# @type=url @sensitive=false
LIVEKIT_URL=

# @sensitive=false
LIVEKIT_API_KEY=

# @sensitive
LIVEKIT_API_SECRET=

# Optional. Cartesia key for the phone agent's voice picker on Setup: searching
# the voice library and playing previews. The voice-agent worker has its own
# copy. Leave empty to hide the picker's search and previews.
# @sensitive
CARTESIA_API_KEY=

# Optional. Where the voice-agent stores call recordings: the same bucket,
# endpoint and region as RECORDING_S3_* on tenant-api and the worker (never the
# keys). App only allows the bucket as a media source so the call detail can
# play a recording from the short-lived link tenant-api signs. Leave empty to
# disable playback.
# @sensitive=false
RECORDING_S3_BUCKET=
# @type=url @required=false @sensitive=false
RECORDING_S3_ENDPOINT=
# @sensitive=false
RECORDING_S3_REGION=
