# Observability package (structured logging, wide events)
# See https://varlock.dev/guides/monorepos/
#
# @currentEnv=$NODE_ENV
# @defaultRequired=infer @defaultSensitive=false
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ----------

# @type=enum(production, development, test)
NODE_ENV=development

# CI, CF_DATACENTER, REGION, and DEPLOYMENT_ID are runtime-injected (see @repo/observability/runtime-env).

# @sensitive=false
SERVICE_NAME=

# @sensitive=false
SERVICE_VERSION=

# BetterStack uptime (status.tsx)
# @sensitive
BETTERSTACK_API_KEY=

# @type=url @sensitive=false
BETTERSTACK_URL=
