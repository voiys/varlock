# Operator authentication package (App + Admin)
# See https://varlock.dev/guides/monorepos/
#
# @currentEnv=$NODE_ENV
# @defaultRequired=infer @defaultSensitive=false
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ----------

# @type=enum(production, development, test)
NODE_ENV=development

# @required @sensitive
SESSION_SECRET=

# Optional override for impersonation cookie signing
# @sensitive
IMPERSONATION_SESSION_SECRET=

# GitHub OAuth (login). MOCK_* defaults enable MSW-backed dev/tests without real credentials.
# @sensitive=false @dynamic
GITHUB_CLIENT_ID=MOCK_GITHUB_CLIENT_ID

# @sensitive
GITHUB_CLIENT_SECRET=MOCK_GITHUB_CLIENT_SECRET

# @type=url @sensitive=false @dynamic
GITHUB_REDIRECT_URI=http://localhost:3001/auth/github/callback

# @sensitive
GITHUB_TOKEN=

# Google OAuth (login)
# @sensitive=false @dynamic
GOOGLE_CLIENT_ID=

# @sensitive
GOOGLE_CLIENT_SECRET=

# @type=url @sensitive=false @dynamic
GOOGLE_REDIRECT_URI=
