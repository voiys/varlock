# Audit log integrity (HMAC) package
# See https://varlock.dev/guides/monorepos/
#
# @currentEnv=$NODE_ENV
# @defaultRequired=infer @defaultSensitive=false
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ----------

# @type=enum(production, development, test)
NODE_ENV=development

# HMAC for audit log integrity. Required in production.
# @sensitive
AUDIT_LOG_SECRET_KEY=

# Previous key kept during rotation
# @sensitive
AUDIT_LOG_OLD_SECRET_KEY=

# Comma-separated extra keys for rotation
# @sensitive
AUDIT_LOG_SECRET_KEYS=
