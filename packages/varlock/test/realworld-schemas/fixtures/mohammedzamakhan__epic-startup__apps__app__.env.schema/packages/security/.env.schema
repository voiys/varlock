# Security package — env vars read by @repo/security
# See https://varlock.dev/guides/monorepos/
#
# @currentEnv=$NODE_ENV
# @defaultRequired=infer @defaultSensitive=false
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ----------

# @type=enum(production, development, test)
NODE_ENV=development

# CSRF honeypot encryption seed (honeypot.server.ts)
# @required @sensitive
HONEYPOT_SECRET="super-duper-s3cret"

# SSO IdP secrets and org S3 credentials (encryption.ts getSSOMasterKey)
# @sensitive
SSO_ENCRYPTION_KEY=

# Integration OAuth token encryption (encryption.ts getEncryptionKey)
# @required @sensitive
INTEGRATION_ENCRYPTION_KEY=

# Client IP extraction behind reverse proxies (ip-address.server.ts)
# @type=boolean @sensitive=false
TRUST_PROXY=false

# @type=number @sensitive=false
TRUSTED_PROXY_COUNT=
