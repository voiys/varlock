# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @public @dynamic @type=url
BETTER_AUTH_URL=

# @type=string(minLength=1)
DATABASE_URL=

# Base dédiée aux tests d'intégration et E2E (jamais la base de développement).
# @optional @type=string(minLength=1)
TEST_DATABASE_URL=

# Stockage S3 compatible des médias (Garage) — voir docs/medias.md.
# @public @type=url
S3_ENDPOINT=http://localhost:3900

# @public @type=string(minLength=1)
S3_REGION=garage

# @public @type=string(minLength=1)
S3_BUCKET=projection

# Identifiant de clé : présent dans chaque URL pré-signée, donc visible du navigateur.
# @public @type=string(minLength=1)
S3_ACCESS_KEY_ID=

# @type=string(minLength=1)
S3_SECRET_ACCESS_KEY=

# Garage auto-hébergé : API d'administration (joignable par le serveur seulement). Le serveur
# initialise alors lui-même un cluster neuf (disposition, clé, bucket). À laisser vide avec
# un S3 externe déjà prêt.
# @optional @public @type=url
GARAGE_ADMIN_URL=

# @optional @type=string(minLength=1)
GARAGE_ADMIN_TOKEN=

# Capacité annoncée pour le nœud Garage, en Go.
# @optional @public @type=number
GARAGE_CAPACITY_GB=
