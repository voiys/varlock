# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @public @type=enum(debug, info, warn, error, fatal)
LOG_LEVEL=info

# Port the API listens on. Override when 3000 is already taken locally.
# @public @type=number
PORT=3000

# @type=string(minLength=32)
BETTER_AUTH_SECRET=dev-secret-key-min-32-chars-long

# @type=url
BETTER_AUTH_URL=http://localhost:3000

# @type=url
CORS_ORIGIN=http://localhost:5173

# @type=string(minLength=1)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rave