# The workspace's shared environment schema (https://varlock.dev).
#
# Every entrypoint that reads process environment variables has a schema next
# to it; this file owns the values more than one service depends on. App
# schemas import it with `pick`, and importing the directory (not just this
# file) is deliberate: a root `.env.local` then applies to every app, while an
# app's own `.env.local` still wins.
#
# Production does not run varlock: the deployment injects real environment
# variables and the `env` CI tier is what proves this schema resolves. Locally,
# the app `dev` scripts run through `varlock run`, and `pnpm env:check` runs
# the same validation CI does.

# @currentEnv=$APP_ENV
# @defaultRequired=infer
# @defaultSensitive=false

# ---

# The environment flag, and the file suffix varlock loads (`.env.development`,
# `.env.local`, ...). `ci` exists only so the committed `.env.ci` fixtures can
# validate every schema without secrets; it is deliberately not `test`, because
# Vite loads `.env.test` into every Vitest process in this workspace.
# @type=enum(development, test, ci, production)
APP_ENV=development

# The connection string every data-backed process uses. Required: the api, the
# worker and the migration runner each refuse to start without it.
# @sensitive @required @type=url(allowedProtocols=[postgres, postgresql])
DATABASE_URL=

# The logger's threshold (packages/logging). Unset means `info`; an unknown
# value refuses to boot there rather than here, so this stays optional. The
# read lives inside @porkbot/logging, outside any app's audited source.
# @type=enum(debug, info, warn, error)
# @auditIgnore
LOG_LEVEL=

# The root for avatars, computer snapshots and archives. The api requires it,
# a supervisor with a real computer provider requires it, and an offline
# supervisor does not, so the requirement lives with each entrypoint.
PORKBOT_STORAGE_DIR=

# The api's door to the supervisor. Both unset means the api boots with its
# computer procedures answering the typed SERVICE_UNAVAILABLE instead of
# pretending a machine is gone.
# @type=url(allowedProtocols=[http, https])
PORKBOT_SUPERVISOR_URL=

# @sensitive
PORKBOT_SUPERVISOR_TOKEN=

# The encrypted credential store's shared keyring: the API encrypts provider
# credentials with it and the worker decrypts them for live runs. Both unset
# lock secret-bearing work while the processes keep serving their other
# surfaces. The reads happen inside @porkbot/db, outside either app's source.
# @sensitive
# @auditIgnore
PORKBOT_CREDENTIAL_KEYS=

# @sensitive
# @auditIgnore
PORKBOT_CREDENTIAL_ACTIVE_KEY=
