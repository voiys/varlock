# The supervisor process's environment schema. Shared values come from the
# root schema; the computer settings here are the generic ones a deployment
# names (PRD provider neutrality: no provider-specific variable).

# @currentEnv=$APP_ENV
# @defaultRequired=infer
# @defaultSensitive=false
# @import(../../, pick=[APP_ENV, LOG_LEVEL, PORKBOT_STORAGE_DIR])
# The computer settings are read in src/computer-provider.ts through the
# `setting`/`choice`/`integer`/`positiveNumber` helpers, which name each
# variable as a string argument; teach the auditor the shape.
# @auditExtraPatterns(regex('(?:setting|choice|integer|positiveNumber)\(\s*env,\s*"([A-Z_]+)"'), fileTypes=[ts])

# ---

# The lifecycle surface's port.
# @type=port
PORT=3003

# The bearer the api presents. Unset is allowed: the surface then refuses
# every call, and boot says so.
# @sensitive
PORKBOT_SUPERVISOR_TOKEN=

# The screen-capability signing key. Unset refuses screen access entirely.
# @sensitive
PORKBOT_SCREEN_TOKEN_SECRET=

# Which computer kind this deployment runs by default. A bot may select any
# configured kind; a kind named here but not configured refuses to boot.
# @type=enum(offline, docker, daytona)
PORKBOT_COMPUTER_PROVIDER=offline

# The machine image both real providers boot.
PORKBOT_COMPUTER_IMAGE=

# The Docker daemon's socket and the machine user's home.
PORKBOT_COMPUTER_SOCKET=/var/run/docker.sock

PORKBOT_COMPUTER_HOME=

# The cloud provider's connection: endpoint and token are all-or-nothing with
# an image, and the toolbox URL is optional.
# @type=url(allowedProtocols=[http, https])
PORKBOT_COMPUTER_ENDPOINT=

# @sensitive
PORKBOT_COMPUTER_TOKEN=

# @type=url(allowedProtocols=[http, https])
PORKBOT_COMPUTER_TOOLBOX_URL=

# The credential-proxy sidecar (slice 7.8): image, signing key and the egress
# network's name. All three or none; a partial configuration refuses to boot.
PORKBOT_COMPUTER_PROXY_IMAGE=

# @sensitive
PORKBOT_PROXY_TOKEN_SECRET=

PORKBOT_COMPUTER_EGRESS_NETWORK=

# Where computer archives are staged; the default is
# DEFAULT_COMPUTER_ARCHIVE_DIRECTORY in @porkbot/adapters.
PORKBOT_COMPUTER_ARCHIVE_DIR=/var/lib/porkbot/computer-archives

# One bot's share of the host: cpus is a positive decimal, memory, disk, pids
# and tmpfs are whole units with a floor of one, and swap may be zero (no
# swap). The memory share is the term that scales with the bots active at once;
# swap is its own, smaller bound.
# @type=number
PORKBOT_COMPUTER_CPUS=1

# @type=number(isInt=true, min=1)
PORKBOT_COMPUTER_MEMORY_MB=512

# @type=number(isInt=true, min=0)
PORKBOT_COMPUTER_SWAP_MB=256

# @type=number(isInt=true, min=1)
PORKBOT_COMPUTER_DISK_MB=10240

# @type=number(isInt=true, min=1)
PORKBOT_COMPUTER_PIDS=512

# @type=number(isInt=true, min=1)
PORKBOT_COMPUTER_TMPFS_MB=256

# The daemon's json-file log rotation for a machine's container. max-size is
# a Docker size string (e.g. 10m); max-file is a positive integer string.
PORKBOT_COMPUTER_LOG_MAX_SIZE=10m

PORKBOT_COMPUTER_LOG_MAX_FILE=3

# @type=enum(missing, always, never)
PORKBOT_COMPUTER_PULL=missing

# Whether `PORKBOT_COMPUTER_DISK_MB` is a write-layer quota. `auto` (the
# default) detects the daemon's storage driver and enforces the budget where it
# answers it, reporting an explicit no-op where it does not; `storage-opt`
# applies it unconditionally (an incapable driver refuses the create); `none`
# never applies it. The drivers that answer a `size` quota are `btrfs` and
# `overlay2` over xfs with pquota; see @porkbot/core's disk-quota register.
# @type=enum(auto, none, storage-opt)
PORKBOT_COMPUTER_DISK_QUOTA=auto

# How many snapshot captures one bot keeps; older archives are pruned after a
# capture and once at boot. Zero keeps everything.
# @type=number(isInt=true, min=0)
PORKBOT_COMPUTER_SNAPSHOT_KEEP=10

# How long a machine may go without a command before it is parked; zero
# disables the sweep. The default is three minutes (DEFAULT_IDLE_TIMEOUT_MS).
# @type=number(isInt=true, min=0)
PORKBOT_COMPUTER_IDLE_MS=180000
