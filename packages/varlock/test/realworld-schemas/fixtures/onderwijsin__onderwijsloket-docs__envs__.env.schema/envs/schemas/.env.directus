# @defaultRequired=infer
# @defaultSensitive=false
# ---

# Directus base URL used by modules and type generation.
# @public
# @required
# @type=url
# @example="https://my-directus-instance.com"
DIRECTUS_URL=protonPass(concat(pass://${PROTON_VAULT}/, $APP_ENV, /DIRECTUS_URL))

# Directus public content token projected into module runtime config.
# @required
# @public
DIRECTUS_PUBLIC_TOKEN=protonPass(concat(pass://${PROTON_VAULT}/, $APP_ENV, /DIRECTUS_PUBLIC_TOKEN))
