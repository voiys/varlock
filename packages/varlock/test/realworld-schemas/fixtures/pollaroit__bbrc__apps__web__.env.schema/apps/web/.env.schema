# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @public @type=url
BETTER_AUTH_URL=

# @type=string(minLength=1)
DATABASE_URL=

# Optional. Neon direct / unpooled URL for Prisma migrate on deploy (recommended on Vercel).
# If omitted, migrate uses DATABASE_URL with `-pooler` stripped from the host.
# @type=string(minLength=1)
DATABASE_URL_UNPOOLED=

# @type=string(minLength=16)
# Secret for `/api/cron/sittings` (optional Bearer layer; QStash uses signing keys).
CRON_SECRET=

# @type=url
# Regional QStash API base (Upstash console → QStash → SDK / REST URL).
QSTASH_URL=

# @type=string(minLength=1)
# Upstash QStash — publish schedules and one-shot messages (server only).
QSTASH_TOKEN=

# @type=string(minLength=1)
# Verify `Upstash-Signature` on incoming QStash webhooks.
QSTASH_CURRENT_SIGNING_KEY=

# @type=string(minLength=1)
# Signing key rotation (Upstash QStash).
QSTASH_NEXT_SIGNING_KEY=

# Optional until Telegram bot is wired. Telegram Bot API token from @BotFather.
# @type=string
TELEGRAM_BOT_TOKEN=

# @public @type=string
# Bot username without @ (deep link on /settings/accounts). Same bot as the club group.
TELEGRAM_BOT_USERNAME=

# Optional. BBRC supergroup chat id (negative number, e.g. -100…).
# @type=string
TELEGRAM_GROUP_CHAT_ID=

# @public @type=string(default=false)
# Kill switch for Telegram announcements (`true` to send).
TELEGRAM_BOT_ENABLED=false

# @type=string(minLength=16)
# Webhook secret (`X-Telegram-Bot-Api-Secret-Token`). Must match setWebhook `secret_token`.
# Telegram allows only A–Z, a–z, 0–9, `_`, `-` (no `=`, `/`, `+`, etc.). Example: `openssl rand -hex 24`.
TELEGRAM_WEBHOOK_SECRET=

# @public @type=url(default=https://ntfy.sh)
NTFY_BASE_URL=https://ntfy.sh

# @type=string(minLength=1)
# Publish token for protected ntfy topics (server-only).
NTFY_TOKEN=

# @public @type=string(default=bbrc)
# Prefix for ntfy topic names (e.g. bbrc-user-<id>, bbrc-admin).
NTFY_TOPIC_PREFIX=bbrc

# @public @type=string(default=Asia/Baku)
# IANA timezone for poll/sitting deadline slots (14:00, 17:00, 20:00, 23:00 club local).
CLUB_TIMEZONE=Asia/Baku

# Optional. Cloudflare R2 (S3-compatible). See docs/SPEC.md — uploads disabled when unset.
# @type=string
R2_ACCOUNT_ID=

# @type=string
R2_ACCESS_KEY_ID=

# @type=string
R2_SECRET_ACCESS_KEY=

# @type=string
R2_BUCKET_NAME=

# @public @type=string
# Public bucket URL (e.g. https://pub-xxxx.r2.dev) for Next.js Image and client links.
R2_PUBLIC_BASE_URL=

# Optional. Google Gemini API key for admin fact draft generation (reels). Server-only.
# @type=string(minLength=1)
GEMINI_API_KEY=

# @public @type=string(default=gemini-2.0-flash-lite)
# Gemini model id for fact drafts (see Google AI Studio model list).
GEMINI_MODEL=gemini-2.0-flash-lite
