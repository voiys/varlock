# This env file uses @env-spec - see https://varlock.dev/env-spec for more info.
# It is the single declared source of truth for web env vars: every variable
# the web app reads must be listed here with a type, required-ness, and a description.
# Real values live in `.env` (local, gitignored) or `.env.local` (personal overrides,
# gitignored, highest precedence) — never commit real secrets here. Only PUBLIC_-prefixed
# values are safe to reach the client bundle; everything else stays server-only.
#
# @defaultRequired=infer @defaultSensitive=inferFromPrefix('PUBLIC_')
# @generateTsTypes(path=env.d.ts)
# ---

# Environment
# @type=enum(development, staging, production) @sensitive=false
ENVIRONMENT=development

# Server (adapter-node runtime)
# Not read by the web server since adapter-node 6; the build-time WEB_ORIGIN replaces it (see deployment runbook).
# @type=url @sensitive=false @required=false
ORIGIN=http://localhost:5173
# @type=string @sensitive=false @required=false
DOMAIN=localhost
# @type=number(min=1) @sensitive=false @required=false
PORT=5173
# @type=string @sensitive=false @required=false
HOST=0.0.0.0

# Web -> API proxy (apps/web /api/[...slug]); falls back to http://127.0.0.1:3001 when unset.
# @type=url @sensitive=false @required=false
API_PROXY_BASE_URL=http://127.0.0.1:3001

# Auth
# Base URL of the Better Auth endpoints for the Better Auth client: the web origin, whose
# /api/auth/* requests are proxied to the API. Must match the API's BETTER_AUTH_URL.
# @type=url @sensitive=false @required=false
BETTER_AUTH_URL=http://localhost:5173

# Storage (SeaweedFS S3 locally; any S3-compatible provider in production). Only the public
# image base URL is read by the web app; it is safe to expose to the client. The default is
# the local SeaweedFS public bucket; it must match the API's PUBLIC_IMAGE_URI and is required.
# @type=url @sensitive=false @required
PUBLIC_IMAGE_URI=http://localhost:8333/adelie-public-development

# Sentry build plugin (source map upload) — only required when enabled for staging/production.
# @type=boolean @sensitive=false @required=false
ENABLE_SENTRY_BUILD_PLUGIN=false
# @type=string @sensitive=false @required=false
SENTRY_ORG=
# @type=string @sensitive=false @required=false
SENTRY_PROJECT=
# @type=url @sensitive=false @required=false
SENTRY_URL=
# @required=false
SENTRY_AUTH_TOKEN=

# Sentry runtime DSN. Safe to expose to the client; leave empty to report to Spotlight only.
# @type=string @sensitive=false @required=false
PUBLIC_SENTRY_DSN=

# OpenTelemetry (Observability)
# @type=boolean @sensitive=false
OTEL_ENABLED=false
# @type=url @sensitive=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
