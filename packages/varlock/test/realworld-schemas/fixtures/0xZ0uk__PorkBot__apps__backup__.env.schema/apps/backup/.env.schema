# The backup process's environment schema. Shared values come from the root
# schema; everything else here is read by apps/backup alone.
#
# @currentEnv=$APP_ENV
# @defaultRequired=infer
# @defaultSensitive=false
# @import(../../, pick=[APP_ENV, DATABASE_URL, LOG_LEVEL])
# The S3 target's credential names are read by the provider as names; teach the
# auditor the shape (the same pattern apps/worker uses for its webhook key).
# @auditExtraPatterns(regex('credentialName:\s*"([A-Z_]+)"'), fileTypes=[ts])

# ---

# The storage root the homes are read from: the same seam the API and the
# supervisor write through. A snapshot archive is the home's durable copy, so
# backing it up here is what makes a remote-computer home recoverable.
PORKBOT_STORAGE_DIR=

# Where the encrypted backup objects live when the target is local. Ignored
# when an S3-compatible endpoint is configured.
PORKBOT_BACKUP_DIR=/var/lib/porkbot/backups

# Where the sealed key envelope is written. Deliberately a different location
# from the backup destination: the envelope plus the operator's passphrase is
# what recovers the keyring after the deployment is gone.
PORKBOT_BACKUP_ENVELOPE_DIR=/var/lib/porkbot/backup-envelope

# The backup keyring: a comma-separated `id:base64key` list and the id new
# writes use, exactly like the credential keyring but independent material.
# @sensitive
PORKBOT_BACKUP_KEYS=

PORKBOT_BACKUP_ACTIVE_KEY=k1

# The passphrase the key envelope is sealed under. It is never stored: the
# envelope is useless without it, which is what makes the file safe to copy
# into a vault.
# @sensitive
PORKBOT_BACKUP_ENVELOPE_PASSPHRASE=

# The nightly time of day, in UTC. The default is after the operator's day in
# every inhabited timezone.
PORKBOT_BACKUP_SCHEDULE_HOUR_UTC=3

PORKBOT_BACKUP_SCHEDULE_MINUTE_UTC=0

# How many days a backup object stays readable. The newest successful run is
# always kept, however old it is.
PORKBOT_BACKUP_RETENTION_DAYS=30

# Days between restore drills. A drill restores the latest backup into a
# scratch database on the same server and asserts the canary reads back.
PORKBOT_BACKUP_DRILL_INTERVAL_DAYS=30

# The S3-compatible destination. All five or none: unset keeps the local
# directory above, and setting only some fails at boot rather than silently
# backing up nowhere off-site.
# @type=url(allowedProtocols=[http, https])
PORKBOT_BACKUP_S3_ENDPOINT=

PORKBOT_BACKUP_S3_BUCKET=

PORKBOT_BACKUP_S3_REGION=us-east-1

# The access keys, resolved by name through the environment credential store.
# @sensitive
PORKBOT_BACKUP_S3_ACCESS_KEY_ID=

# @sensitive
PORKBOT_BACKUP_S3_SECRET_ACCESS_KEY=
