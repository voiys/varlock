# =============================================================================
# Finance Tracker — Environment Schema
# =============================================================================
# Single source of truth for all environment variables.
# Docs: https://varlock.dev
# =============================================================================

# @defaultSensitive=true
# @defaultRequired=infer
# @currentEnv=$APP_ENV
# preventLeaks and redactLogs both key off sensitivity: every non-empty
# sensitive string is enrolled, and preventLeaks throws on any response body
# containing one, via a bare substring match with no length floor. Short
# non-secret values must stay public. Port-typed items coerce to numbers, so
# only strings enrol.
# A comment line whose first token is a sigil parses as decorators, item
# comments included; keep them mid-line when rewrapping, as in @type=port here.
# @preventLeaks=forEnv(production)
# @redactLogs=forEnv(production)
# @generateTsTypes(path=src/env.d.ts)
# ---

# =============================================================================
# Environment
# =============================================================================

# @public @optional
NODE_ENV=

# @public @type=enum(development, production, test)
APP_ENV=fallback($NODE_ENV, development)

# =============================================================================
# Auth (Better Auth + OAuth)
# =============================================================================

# @sensitive @required @type=string(minLength=32)
BETTER_AUTH_SECRET=if(forEnv(development, test), dev-secret-32-characters-long-min)

# @public @optional @type=port
PORT=3000

# Dynamic so it resolves at runtime rather than being folded into the build.
# TRUSTED_ORIGINS below derives from it, so a stale build-time value would take
# the CSRF allow-list with it.
# The default is gated to dev/test so production fails fast on a missing value.
# Ungated, it would satisfy @required with localhost and take TRUSTED_ORIGINS
# down with it, booting an app that rejects every real origin.
# @public @dynamic @required @type=url
BETTER_AUTH_URL=if(forEnv(development, test), "http://localhost:${PORT}")

# Comma-separated CSRF allow-list, not a secret — browsers already know these,
# and it holds the app's own origin, which responses echo. Defaults to the app
# URL so a single-origin deploy needs no value of its own. Public so it is not
# leak-scanned; dynamic so it resolves at runtime instead of being folded in.
# @public @dynamic @required
TRUSTED_ORIGINS="${BETTER_AUTH_URL}"

# @public @required
GITHUB_CLIENT_ID=test-github-id

# @sensitive @required
GITHUB_CLIENT_SECRET=test-github-secret

# @public @required
GOOGLE_CLIENT_ID=test-google-id

# @sensitive @required
GOOGLE_CLIENT_SECRET=test-google-secret

# =============================================================================
# Database
# =============================================================================
# Host, user and database name are public: `localhost` and `finance_tracker`
# are not secrets and are short enough to collide. DB_PASSWORD and DATABASE_URL
# carry the credential and stay sensitive; DB_PORT stays sensitive too, since
# a port number never enrols in the leak scan regardless.

# @public @required
DB_HOST=localhost

# @sensitive @required @type=port
DB_PORT=5432

# @public @required
DB_USER=finance_tracker

# @sensitive @required
DB_PASSWORD=finance_tracker_password

# @public @required
DB_NAME=finance_tracker_dev

# @sensitive @required
DATABASE_URL="postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}"

# Host port docker-compose publishes Postgres on. Read by docker-compose.yml,
# never by app code, so `varlock audit` cannot see the usage.
# @public @optional @type=port @auditIgnore
POSTGRES_PORT=

# =============================================================================
# Email — dev uses Mailpit (SMTP); production uses Brevo API
# =============================================================================
# The host and both addresses are public — the addresses are published on
# outgoing mail. SMTP_HOST is empty in production, so it only ever mattered to
# `varlock scan`, where its dev value `localhost` collides tree-wide.
# BREVO_API_KEY is the only credential here.
# Every public item email.ts reads through ENV carries @dynamic, because a
# public static item is replaced with a literal in the server bundle as well as
# the client — baking the APP_ENV=test build defaults and silently swallowing
# runtime overrides.

# @public @dynamic @optional @type=string
SMTP_HOST=if(forEnv(development, test), localhost)

# @sensitive @optional @type=port
SMTP_PORT=if(forEnv(development, test), 1025)

# @public @dynamic @required @type=email
EMAIL_FROM=no-reply@finance.oakoss.dev

# @public @dynamic @optional
EMAIL_FROM_NAME=Finance Tracker

# @public @dynamic @required @type=email
EMAIL_REPLY_TO=support@finance.oakoss.dev

# @sensitive @required=forEnv(production)
BREVO_API_KEY=

# =============================================================================
# Logging (evlog + PostHog OTLP)
# =============================================================================

# @sensitive @optional @type=url
OTEL_EXPORTER_OTLP_ENDPOINT=

# Consumed by evlog's OTLP adapter as a service-name fallback, not by our
# code, so `varlock audit` cannot see the usage. drain.ts passes serviceName
# explicitly today, which takes precedence. Public because a short name like
# `finance-tracker` would collide with the export filenames in build-export.ts.
# @public @optional @auditIgnore
OTEL_SERVICE_NAME=

# @sensitive @optional
OTEL_RESOURCE_ATTRIBUTES=

# @sensitive @required @type=string(minLength=32)
# Used for HMAC-SHA256 ID hashing in audit logs
LOG_HASH_SECRET=if(forEnv(development, test), dev-placeholder-secret-do-not-use-in-prod)

# =============================================================================
# PostHog Analytics (optional — no-ops when unset)
# =============================================================================

# @public @optional
POSTHOG_KEY=

# @public @optional @type=url
POSTHOG_HOST=

# =============================================================================
# PostHog Source Maps (build-only — CI secrets, not needed at runtime)
# =============================================================================

# @sensitive @optional
POSTHOG_PERSONAL_API_KEY=

# @sensitive @optional
POSTHOG_PROJECT_ID=

# =============================================================================
# Client (public — safe for browser bundle)
# =============================================================================

# @public @type=enum(debug, info, warn, error)
CLIENT_LOG_LEVEL=warn

# =============================================================================
# E2E Testing (Playwright)
# =============================================================================

# Boots `pnpm dev` instead of build+start for E2E. Allowlisted in
# playwright.config.ts so 0/false read as off.
# @public @optional
E2E_DEV=

# @public @optional @type=email
E2E_USER_EMAIL=e2e@test.local

# @sensitive @optional
E2E_USER_PASSWORD=E2ePassword1!

# =============================================================================
# Build & tooling
# =============================================================================

# Set to 1 to keep real sourcemap contents in the build output; otherwise the
# wrapper strips them to prevent source leak. See vite.config.ts.
# @public @optional
STRICT_SOURCEMAPS=

# Set by the CI runner; read in playwright.config.ts to pick retry/worker
# counts. Never set locally.
# @public @optional
CI=
