{
  "manifestVersion": 1,
  "name": "@varlock/hashicorp-vault-plugin",
  "icon": "simple-icons:vault",
  "bundledIcons": {
    "simple-icons:vault": "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\"><path fill=\"currentColor\" d=\"m0 0l11.955 24L24 0zm13.366 4.827h1.393v1.38h-1.393zm-2.77 5.569H9.22V8.993h1.389zm0-2.087H9.22V6.906h1.389zm0-2.086H9.22V4.819h1.389zm2.087 6.263h-1.377V11.08h1.388zm0-2.09h-1.377V8.993h1.388zm0-2.087h-1.377V6.906h1.388zm0-2.086h-1.377V4.819h1.388zm.683.683h1.393v1.389h-1.393zm0 3.475V8.993h1.389v1.388Z\"/></svg>"
  },
  "standardVars": {
    "initDecorator": "@initHcpVault",
    "params": {
      "url": {
        "key": "VAULT_ADDR"
      },
      "token": {
        "key": "VAULT_TOKEN",
        "dataType": "vaultToken"
      },
      "namespace": {
        "key": "VAULT_NAMESPACE"
      }
    }
  },
  "rootDecorators": [
    {
      "name": "initHcpVault",
      "description": "Initialize a HashiCorp Vault plugin instance for vaultSecret() resolver",
      "isFunction": true
    }
  ],
  "itemDecorators": [],
  "dataTypes": [
    {
      "name": "vaultToken",
      "typeDescription": "HashiCorp Vault authentication token",
      "sensitive": true,
      "internal": true,
      "docs": [
        {
          "description": "Vault Tokens",
          "url": "https://developer.hashicorp.com/vault/docs/concepts/tokens"
        }
      ]
    }
  ],
  "resolvers": [
    {
      "name": "vaultSecret",
      "label": "Fetch secret from HashiCorp Vault KV v2",
      "argsSchema": {
        "type": "mixed",
        "arrayMinLength": 0,
        "arrayMaxLength": 2
      }
    },
    {
      "name": "vaultToken",
      "label": "HashiCorp Vault client token",
      "impliesSensitive": true,
      "argsSchema": {
        "type": "array",
        "arrayMaxLength": 1
      }
    }
  ],
  "codeGenerators": []
}
