  "rootDecorators": [
    {
      "name": "initKeePass",
      "description": "Initialize a KeePass plugin instance for kp() and kpBulk() resolvers",
      "isFunction": true
    }
  ],
  "itemDecorators": [],
  "dataTypes": [
    {
      "name": "kdbxPassword",
      "typeDescription": "Master password for a KeePass KDBX database file",
      "sensitive": true,
      "internal": true,
      "docs": [
        {
          "description": "KeePassXC documentation",
          "url": "https://keepassxc.org/docs/"
        }
      ],
      "validationRules": [
        {
          "minLength": 1,
          "message": "KeePass database password must be a non-empty string"
        }
      ]
    }
  ],
  "resolvers": [
    {
      "name": "kp",
      "label": "Fetch a single secret from a KeePass database entry",
      "argsSchema": {
        "type": "mixed",
        "arrayMinLength": 0,
        "arrayMaxLength": 2
      }
    },
    {
      "name": "kpBulk",
      "label": "Load all secrets from a KeePass database group as a JSON map",
      "argsSchema": {
        "type": "mixed",
        "arrayMaxLength": 2
      }
    }
  ],
  "codeGenerators": []
}
