{
  "manifestVersion": 1,
  "name": "@varlock/keeper-plugin",
  "icon": "simple-icons:keeper",
  "bundledIcons": {
    "simple-icons:keeper": "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\"><path fill=\"currentColor\" d=\"M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12s12-5.373 12-12S18.627 0 12 0m1.365 1.788l1.854.472v2.597l2.073-1.704l1.537 1.135l-3.949 3.247l-1.515-.008zm-9.067 15.54L2.445 15.75V8.7L4.298 7zm3.631 2.22L6.076 21.16V3l1.853 1.614zm9.363 1.555l-2.073-1.705v2.597l-1.854.473v-5.74l1.515-.007l3.95 3.246zm2.733-2.473l-4.604-3.674h-3.826v7.512H9.742v-9.365h6.329l5.11 4.078zm2.62-8.329l-2.059 1.7l2.059 1.698l-1.181 1.431L17.67 12l3.793-3.13zm-6.574.6H9.742V1.534h1.853v7.512h3.826l4.604-3.674l1.156 1.449z\"/></svg>"
  },
  "standardVars": {
    "initDecorator": "@initKeeper",
    "params": {
      "token": {
        "key": "KSM_CONFIG",
        "dataType": "keeperSmToken"
      }
    }
  },
  "rootDecorators": [
    {
      "name": "initKeeper",
      "description": "Initialize a Keeper Secrets Manager plugin instance",
      "isFunction": true
    }
  ],
  "itemDecorators": [],
  "dataTypes": [
    {
      "name": "keeperSmToken",
      "typeDescription": "Base64-encoded configuration token for the [Keeper Secrets Manager](https://docs.keeper.io/secrets-manager/) SDK",
      "sensitive": true,
      "internal": true,
      "docs": [
        {
          "description": "Keeper Secrets Manager",
          "url": "https://docs.keeper.io/secrets-manager/"
        },
        {
          "description": "JavaScript SDK",
          "url": "https://docs.keeper.io/secrets-manager/secrets-manager/developer-sdk-library/javascript-sdk"
        }
      ],
      "validationRules": [
        {
          "matches": "/\\S/",
          "message": "Keeper Secrets Manager config token must be a non-empty string"
        },
        {
          "custom": "decodes from base64 and parses as JSON",
          "message": "Keeper Secrets Manager config token must be a valid base64-encoded JSON string"
        }
      ]
    }
  ],
  "resolvers": [
    {
      "name": "keeper",
      "label": "Fetch a secret field from Keeper Secrets Manager",
      "argsSchema": {
        "type": "mixed",
        "arrayMinLength": 1,
        "arrayMaxLength": 2
      }
    }
  ],
  "codeGenerators": []
}
